    city: Venice
    region: California
    country: US
repository-code: https://github.com/ThePigLA/PachnerDCG
license: CC0-1.0
date-released: 2026-08-17
keywords:
  - Pachner graph
  - bistellar flip
  - triangulated 3-sphere
  - flip graph
  - simplicial complex
  - combinatorial topology
  - unflippable triangulation
  - computational certificate
